rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada jugador solo puede leer y escribir su propio progreso.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Salas del cooperativo online: el anfitrión la crea y la borra; un invitado deja su respuesta.
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.host == resource.data.host
        && (!('guest' in resource.data) || resource.data.guest == request.auth.uid);
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }
  }
}
